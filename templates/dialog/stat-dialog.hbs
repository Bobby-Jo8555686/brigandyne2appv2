<div class="b2-dialog-window">
    <form class="b2-dialog">
        {{#if target}}
        <div class="b2-section theme-opposition">
            <div class="b2-dialog-row">
                <label class="b2-dialog-label text-red"><i class="fas fa-crosshairs"></i> Opposition face à {{target.name}} :</label>
                <div class="b2-dialog-controls flex-2">
                    <select id="targetStat" class="w-100">
                        {{{statOptions}}}
                    </select>
                </div>
            </div>
        </div>
        {{/if}}
        
        {{{atoutsHtml}}}
        
        <div class="b2-section b2-section-dark">
            <div class="b2-dialog-row b2-row-centered">
                <div class="b2-dialog-label text-center text-grey">Difficulté / Facilité</div>
                <div class="b2-dialog-controls">
                    <div class="b2-pips align-center gap-4" data-target="modDifficulte">
                        <div class="b2-pip neg" data-val="-40"><i class="fas fa-minus"></i></div>
                        <div class="b2-pip neg" data-val="-30"><i class="fas fa-minus"></i></div>
                        <div class="b2-pip neg" data-val="-20"><i class="fas fa-minus"></i></div>
                        <div class="b2-pip neg" data-val="-10"><i class="fas fa-minus"></i></div>
                        <input type="number" id="modDifficulte" class="b2-pip-input" value="0" step="10" min="-40" max="40">
                        <div class="b2-pip pos" data-val="10"><i class="fas fa-plus"></i></div>
                        <div class="b2-pip pos" data-val="20"><i class="fas fa-plus"></i></div>
                        <div class="b2-pip pos" data-val="30"><i class="fas fa-plus"></i></div>
                        <div class="b2-pip pos" data-val="40"><i class="fas fa-plus"></i></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="b2-section b2-section-dark" style="margin-top: 10px;">
            <div class="b2-dialog-row b2-row-centered pb-0">
                <div class="b2-dialog-label text-center text-gold">Bonus / Malus libre (+/-)</div>
                <div class="b2-dialog-controls" style="padding-bottom: 5px;">
                    <input type="number" id="bonusMalusLibre" class="b2-pip-input" value="0" step="1">
                </div>
            </div>
        </div>
    </form>
</div>
